{
  "name": "quarto-de-despejo",
  "productName": "Quarto de Despejo",
  "version": "1.0.0",
  "description": "Quarto de Despejo - um jogo narrativo inspirado na obra de Carolina Maria de Jesus",
  "author": "Quarto de Despejo",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.quartodedespejo",
    "productName": "Quarto de Despejo",
    "directories": { "output": "dist" },
    "files": ["main.js", "game/**", "build/icon.png"],
    "win": {
      "target": "portable",
      "icon": "build/icon.png",
      "artifactName": "QuartoDeDespejo-${version}.exe"
    }
  }
}
